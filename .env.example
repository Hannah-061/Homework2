# 複製成 .env.local 後再填。.env.local 不會被 commit（.gitignore 已忽略 .env.*）。
# 這個檔案只放欄位名稱，不要放真實的值。

# mock = 階段一的假後台；supabase = 階段二的真後台
VITE_BACKEND=mock

# 以下兩個只有階段二才需要（Supabase 後台 Settings → API Keys）。
# 只能填 Project URL 與 publishable key（sb_publishable_...），絕對不要填 secret key。
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
